# secrets — never commit API keys
.env
.env.local
*.key
keys.env

node_modules/
dist/
.DS_Store
*.log

# Gemini raw output cache — intermediates, regenerable via tools/gen-avatars.py
tools/.art-raw/

# Epic card masters are book assets, not app assets — deploy.sh only copies app/.
# They are committed deliberately so they survive the container.

# Python bytecode from the generator scripts.
__pycache__/
*.pyc
.shots/

# Rendered video. The inputs are all in the repo (story text, narration, character art,
# the story painting) and tools/veo-story.py rebuilds the film from them, so a hundred
# megabytes of MP4 in git would only go stale the first time a line is re-recorded.
build/

# Generated shot pages. tools/anim/build.js writes one per shot from scenes.json plus the
# sprite manifest, so they are output, not source — committing them means every geometry
# tweak shows up as ten meaningless diffs.
tools/anim/shot-*.html
tools/anim/sprites.json
